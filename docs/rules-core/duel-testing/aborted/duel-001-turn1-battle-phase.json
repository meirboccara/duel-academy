  "disputes": [
    {
      "at": 20,
      "turn": 1,
      "phase": "battle",
      "by": "rival",
      "claim": "Turn 1 (the first turn of the duel) went from Main Phase 1 into the battle phase after both players passed. Under TCG rules the player who goes first cannot conduct a Battle Phase on the first turn of the duel; Main Phase 1 should go straight to the End Phase.",
      "ruling": {
        "decision": "Upheld: engine defect. On the first turn of the Duel the player who goes first cannot conduct a Battle Phase, and Main Phase 2 follows only a conducted Battle Phase, so turn 1 must go from Main Phase 1 to the End Phase. The engine entered the Battle Phase (Start Step, then Battle Step) on turn 1; it only blocks attack declarations there (battle.ts attackActions), while chain.ts nextPhase always advances main1 to battle. Duel stopped at this point; state not corrected.",
        "via": "konami",
        "sources": [
          "Rulebook v10 (SD_RuleBook_EN_10.pdf) p. 34: \"IMPORTANT: The player who goes first cannot conduct their Battle Phase on their first turn.\"",
          "Rulebook v10 p. 34 turn flowchart: \"If no battles are conducted\" Main Phase 1 goes to the End Phase",
          "Rulebook v10 p. 39: \"If you conducted your Battle Phase, your turn moves to Main Phase 2 afterwards.\"",
          "repo record no-battle-first-turn (src/battle-sources.ts)"
        ]
      }
    }
