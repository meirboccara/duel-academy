  "disputes": [
    {
      "at": 12,
      "turn": 1,
      "phase": "main1",
      "by": "you",
      "claim": "Potential Linkage timing bug: activating Linkage immediately moved Kagari to GY before opponent response and before Linkage resolves. Linkage sends the other controlled card as part of its effect, not activation cost. Chain currently shows Impermanence target following Kagari into GY. No state correction attempted.",
      "ruling": {
        "decision": "No error. After Linkage (chain link 3) was activated the rival had no legal response (only pass was legal), so the engine passed for them (act auto-pass, everyWindow off). Linkage then resolved: Kagari, the only card whose sending leaves room for an Ace, was sent by the effect, not as a cost, and the Ace was chosen. Impermanence then had no target (Kagari had left the field) and applied nothing. Kagari link 1 still added Widow Anchor. The chain target arrow following Kagari to the GY is display only. Follow-up: the engine log does not show passes made for a player, which made this look like a skipped response window.",
        "via": "konami",
        "sources": [
          "Sky Striker Mobilize - Linkage! cid 17034 card text (send 1 other card ... and if you do, Special Summon) and notes-only-emz-monster",
          "Infinite Impermanence cid 13631: Target 1 face-up monster your opponent controls",
          "test/cards/sky-striker-mobilize-linkage.test.ts auto-pass regression (repo)"
        ]
      }
    },
    {
      "at": 14,
      "turn": 1,
      "phase": "main1",
      "by": "you",
      "claim": "Move offered: activate sky-striker-mecha-widow-anchor > sky-striker-ace-shizuku. Widow Anchor (cid 13733) targets 1 face-up monster your opponent controls. Offering my own Shizuku as target appears illegal. Not taking the move; no state correction.",
      "ruling": {
        "decision": "Rejected and withdrawn by the raising player: Widow Anchor may target your own face-up Effect Monster. Its text says Target 1 face-up Effect Monster on the field, without an opponent-control requirement. The accepted activation on Shizuku stands; no undo or state correction.",
        "via": "konami",
        "sources": [
          "https://www.db.yugioh-card.com/yugiohdb/card_search.action?ope=2&cid=13675&request_locale=en",
          "src/cards/sky-striker-mecha-widow-anchor.ts condition and notes-targets source records"
        ]
      }
    },
    {
      "at": 22,
