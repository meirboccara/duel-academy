# Card search (local Docker: `docker compose up -d` in apps/academy-ygo). Copy to .env.local.

# YGOProJudge's database, read-only login. Duel Academy never writes there.
CARDS_DATABASE_URL=postgresql://academy_reader:academy_reader@localhost:5434/ygojudge

# Duel Academy's own database: the kid explanations.
ACADEMY_DATABASE_URL=postgresql://academy:academy@localhost:5434/academy
